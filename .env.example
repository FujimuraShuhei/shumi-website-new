# ============================================================
# Vercel の Project Settings → Environment Variables に登録してください。
# 空のままでもビルド・表示はできます（記事と実績は content/ フォルダのファイル）。
# 「NEXT_PUBLIC_」で始まるものはサイトに表示される公開情報です。
# それ以外（キー・シークレット・受信用メール）は絶対に公開されません。
# ============================================================

# --- サイト ---------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://shumiofficial.com
NEXT_PUBLIC_BUSINESS_HOURS=9:00–18:00

# --- 会社情報（しゅうみについて・フッターに表示）--------------
NEXT_PUBLIC_COMPANY_NAME=Shumiデザイン
NEXT_PUBLIC_COMPANY_FOUNDED=2022年10月7日
NEXT_PUBLIC_COMPANY_REPRESENTATIVE=
NEXT_PUBLIC_COMPANY_ADDRESS=神奈川県横浜市
# 表示したい場合だけ入力（空なら表示しません）
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- メール（Resend で送信 → Gmail で受信）--------------------
RESEND_API_KEY=
# Resendでドメイン認証したアドレス
MAIL_FROM=Shumi <noreply@shumiofficial.com>
# 問い合わせ通知を受け取る Gmail アドレス（サイトには表示されません）
CONTACT_TO=

# --- スパム対策（Cloudflare Turnstile）-------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- 連続送信の制限（任意。Vercel Marketplace の Upstash Redis）---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
